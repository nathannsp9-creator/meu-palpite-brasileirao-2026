rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função helper para verificar se o usuário é admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Função helper para verificar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Função helper para verificar se a rodada está aberta para palpites
    function isRodadaAberta(rodadaId) {
      let rodada = get(/databases/$(database)/documents/rodadas/$(rodadaId));
      return rodada.data.data_fechamento > request.time;
    }
    
    // Coleção: profiles
    // Perfis: leitura pública; usuário só cria/atualiza o próprio
    match /profiles/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }
    
    // Coleção: user_roles
    // Roles: leitura só para autenticados; escrita só via console/backend
    match /user_roles/{userId} {
      allow read: if isAuthenticated();
      allow write: if false; // Apenas via console ou backend
    }
    
    // Coleção: rodadas
    // Rodadas: leitura pública; escrita só admin
    match /rodadas/{rodadaId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Coleção: jogos
    // Jogos: leitura pública; escrita só admin
    match /jogos/{jogoId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Coleção: palpites
    // Palpites: leitura pública; usuário só cria/edita o próprio; admin pode atualizar (para cálculo de pontos)
    // Palpites só podem ser criados/editados se a rodada ainda estiver aberta
    match /palpites/{palpiteId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                       request.resource.data.usuario_id == request.auth.uid &&
                       isRodadaAberta(request.resource.data.rodada_id);
      allow update: if isAdmin() || 
                       (isAuthenticated() && 
                        resource.data.usuario_id == request.auth.uid &&
                        isRodadaAberta(resource.data.rodada_id));
      allow delete: if false;
    }
  }
}
