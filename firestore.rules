rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNÇÕES HELPER ---

    // Verifica se o usuário é admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Verifica apenas se está logado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verifica se a rodada aceita palpites
    // CORREÇÃO: Status alterado para 'em_andamento' para coincidir com a lógica do seu app
    function isRodadaAberta(rodadaId) {
      let rodada = get(/databases/$(database)/documents/rodadas/$(rodadaId));
      return rodada.data.status == 'em_andamento' && 
             rodada.data.data_fechamento > request.time;
    }

    // Verifica se o Jogo (jogoId) realmente faz parte da Rodada (rodadaId) informada
    function jogoPertenceARodada(jogoId, rodadaId) {
       return get(/databases/$(database)/documents/jogos/$(jogoId)).data.rodada_id == rodadaId;
    }
    
    // --- REGRAS DAS COLEÇÕES ---

    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }
    
    match /user_roles/{userId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    match /rodadas/{rodadaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /jogos/{jogoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Palpites: O coração do app
    match /palpites/{palpiteId} {
      allow read: if true;
      
      // CRIAR (CORRIGIDO):
      // Agora começa com "isAdmin() ||". O Admin consegue criar palpites sempre.
      // Usuários comuns precisam respeitar as regras de rodada aberta.
      allow create: if isAdmin() || (
                       isAuthenticated() && 
                       request.resource.data.usuario_id == request.auth.uid &&
                       jogoPertenceARodada(request.resource.data.jogo_id, request.resource.data.rodada_id) &&
                       isRodadaAberta(request.resource.data.rodada_id)
                    );

      // ATUALIZAR:
      // Admin edita sempre; Usuário edita o próprio se a rodada estiver aberta.
      allow update: if isAdmin() || 
                       (isAuthenticated() && 
                        resource.data.usuario_id == request.auth.uid &&
                        jogoPertenceARodada(resource.data.jogo_id, resource.data.rodada_id) &&
                        isRodadaAberta(resource.data.rodada_id));
                        
      allow delete: if isAdmin();
    }
  }
}